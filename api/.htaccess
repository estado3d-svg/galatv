<?php
/**
 * GalaTV API - .htaccess para URL amigables
 * Permite usar /api/estado en lugar de /api/estado.php
 *
 * Subir este archivo a: galatv.com.ar/api/.htaccess
 */

RewriteEngine On

# /api/estado -> estado.php
RewriteRule ^estado/?$ estado.php [L,QSA]

# /api/programacion -> programacion.php
RewriteRule ^programacion/?$ programacion.php [L,QSA]

# Bloquear acceso directo a config.php
RewriteRule ^config\.php$ - [F,L]
